# =============================================================================
# CONFIGURATION — AUCUNE VALEUR REELLE DANS CE FICHIER
# Copier vers .env.local et renseigner. Les fichiers .env* sont ignores par Git.
# Documentation complete : docs/CONFIGURATION_SUPABASE.md
# =============================================================================

# -----------------------------------------------------------------------------
# REGLE DE SECURITE — ADR-002
# -----------------------------------------------------------------------------
# Toute variable prefixee VITE_ est injectee dans le bundle CLIENT par Vite.
# Elle est donc PUBLIQUE, definitivement et pour tout le monde.
# Un secret ne porte JAMAIS le prefixe VITE_.
#
# Cette regle est verifiee automatiquement :
#   - `npm run build` echoue si une variable serveur est lue depuis src/
#   - `npm run build` echoue si une variable VITE_ contient SECRET, SERVICE_ROLE,
#     PRIVATE, PASSWORD, CREDENTIAL, PEPPER...
#   - le bundle produit est inspecte apres chaque build
# -----------------------------------------------------------------------------


# =============================================================================
# BLOC 1 — VARIABLES CLIENT (PUBLIQUES)
# Embarquees dans le bundle navigateur. N'y placer que ce qu'on accepterait
# de publier sur une page web.
# =============================================================================

# URL du projet Supabase. Publique : elle figure dans chaque requete.
VITE_SUPABASE_URL=

# Cle publishable (sb_publishable_...). Privileges faibles, soumise aux
# politiques RLS. SEULE cle Supabase autorisee cote navigateur.
# Une cle sb_secret_... ou un JWT service_role placé ici est rejete au demarrage.
VITE_SUPABASE_PUBLISHABLE_KEY=

# URL de NOTRE couche de services de routage — JAMAIS celle d'OSRM.
# OSRM tourne sur une VM privee, non joignable depuis le navigateur.
# La couche de services porte authentification, quotas, delais d'expiration
# et journalisation sans donnees sensibles.
#   navigateur -> couche de services -> OSRM (VM privee)
# Voir docs/FICHE_DECISION_OSRM.md §1.
VITE_ROUTING_BASE_URL=

# DSN Sentry. Publique par conception.
VITE_SENTRY_DSN=

# 'true' pour activer le monitoring en local. Inactif par defaut : l'envoi
# vers un service tiers doit rester un acte delibere.
VITE_SENTRY_ENABLE_DEV=

# development | staging | production
VITE_APP_ENV=development


# =============================================================================
# BLOC 2 — VARIABLES SERVEUR (SECRETES)
# Ne JAMAIS renseigner ici. Ne JAMAIS prefixer VITE_.
# Elles vivent dans les secrets Supabase (Edge Functions) ou ceux de la
# plateforme d'hebergement. Listees en commentaire a titre documentaire
# uniquement — les renseigner fait echouer le build.
# =============================================================================

# SUPABASE_SECRET_KEY                 Cle secret (sb_secret_...). Contourne les RLS.
# SUPABASE_SERVICE_ROLE_KEY           Cle legacy. Ne plus utiliser.
# SUPABASE_JWT_SECRET                 Secret de signature des jetons.
# SUPABASE_DB_PASSWORD                Mot de passe Postgres. Migrations uniquement.
# SMS_PROVIDER_PRIMARY_CREDENTIALS    Fournisseur SMS principal.
# SMS_PROVIDER_FALLBACK_CREDENTIALS   Fournisseur SMS de repli.
# OTP_HASH_PEPPER                     Poivre du hachage des codes OTP.
