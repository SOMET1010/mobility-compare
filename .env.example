# =============================================================================
# EXEMPLE DE CONFIGURATION — AUCUNE VALEUR RÉELLE ICI
# Copier vers .env.local et renseigner. .env* est ignoré par Git.
# =============================================================================

# -----------------------------------------------------------------------------
# RÈGLE DE SÉCURITÉ — À NE JAMAIS ENFREINDRE
# -----------------------------------------------------------------------------
# Toute variable préfixée VITE_ est injectée dans le bundle CLIENT par Vite.
# Elle est donc PUBLIQUE. Un secret ne porte JAMAIS le préfixe VITE_.
# Les secrets serveur vivent dans le gestionnaire de secrets Supabase,
# jamais dans ce fichier, jamais dans le dépôt.
# Voir docs/adr/ADR-002-gestion-des-secrets.md
# -----------------------------------------------------------------------------

# --- Client (PUBLIC, embarqué dans le bundle) --------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=      # sb_publishable_... — jamais la clé secret
VITE_APP_ENV=development             # development | staging | production
VITE_SENTRY_DSN=                     # optionnel
VITE_SENTRY_ENABLE_DEV=              # 'true' pour activer Sentry en local (inactif par defaut)

# --- Routing (PUBLIC : URL du service, pas de credential) --------------------
VITE_ROUTING_BASE_URL=               # ex. https://routing.<domaine>/route/v1

# --- Serveur (JAMAIS de préfixe VITE_, jamais commité) -----------------------
# À déclarer dans les secrets Supabase, pas ici.
# SUPABASE_SECRET_KEY=               # sb_secret_...
# SMS_PROVIDER_PRIMARY_CREDENTIALS=
# SMS_PROVIDER_FALLBACK_CREDENTIALS=
# OTP_HASH_PEPPER=
